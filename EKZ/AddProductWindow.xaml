<Window x:Class="EKZ.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить товар" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel>
            <TextBox x:Name="CategoryBox" ToolTip="Категория" Margin="2"/>
            <TextBox x:Name="NameBox" ToolTip="Название" Margin="2"/>
            <TextBox x:Name="DescriptionBox" ToolTip="Описание" Margin="2"/>
            <TextBox x:Name="ManufacturerBox" ToolTip="Производитель" Margin="2"/>
            <TextBox x:Name="SupplierBox" ToolTip="Поставщик" Margin="2"/>
            <TextBox x:Name="PriceBox" ToolTip="Цена (число)" Margin="2"/>
            <TextBox x:Name="UnitBox" ToolTip="Ед. измерения" Margin="2"/>
            <TextBox x:Name="QuantityBox" ToolTip="Количество (целое)" Margin="2"/>
            <TextBox x:Name="DiscountBox" ToolTip="Скидка (0-100)" Margin="2"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Добавить" Click="AddButton_Click" Width="80" Margin="2"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="2"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>