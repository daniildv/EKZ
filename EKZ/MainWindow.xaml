<Window x:Class="EKZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EKZ"
        mc:Ignorable="d"
        Title="Каталог Товаров" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate x:Key="ProductTemplate">
            <Border Margin="10" BorderBrush="Black" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/default.png" Stretch="UniformToFill" Height="70" Width="70"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Category}"/>
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Description}"/>
                        <TextBlock Text="{Binding Manufacturer}"/>
                        <TextBlock Text="{Binding Supplier}"/>
                        <TextBlock Text="{Binding Price}"/>
                        <TextBlock Text="{Binding Unit}"/>
                        <TextBlock Text="{Binding Quantity}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Discount }"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsList" ItemTemplate="{StaticResource ProductTemplate}"/>
        </ScrollViewer>
    </Grid>


</Window>
